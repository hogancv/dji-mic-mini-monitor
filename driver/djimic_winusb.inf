; WinUSB binding for DJI Mic Mini receiver, vendor-specific interface 6
; Target hardware id: USB\VID_2CA3&PID_4011&MI_06
; Binds Microsoft winusb.sys so user-mode code can reach Bulk OUT 0x06 / Bulk IN 0x86.

[Version]
Signature   = "$Windows NT$"
Class       = USBDevice
ClassGuid   = {88BAE032-5A81-49f0-BC3D-A4FF138216D6}
Provider    = %PROVIDER%
DriverVer   = 10/22/2026,1.0.0.0
CatalogFile = djimic_winusb.cat
PnpLockdown = 1

[Manufacturer]
%PROVIDER% = DJIMic,NTamd64

[DJIMic.NTamd64]
%DEVICE% = DJIMic_Install, USB\VID_2CA3&PID_4011&MI_06

[DJIMic_Install.NT]
Include = winusb.inf
Needs   = WINUSB.NT

[DJIMic_Install.NT.Services]
Include = winusb.inf
Needs   = WINUSB.NT.Services

[DJIMic_Install.NT.HW]
AddReg  = DJIMic_HW

[DJIMic_HW]
HKR,,DeviceInterfaceGUIDs,0x10000,"{A5DCBF10-6530-11D2-901F-00C04FB951ED}"

[Strings]
PROVIDER = "DJI Mic Mini WinUSB"
DEVICE   = "DJI Mic Mini Control Interface"
